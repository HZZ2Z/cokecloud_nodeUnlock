def rest_url(cfg, path):
    return f"http://127.0.0.1:{cfg.get('api_port', 9090)}{path}"


def rest(cfg, method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(rest_url(cfg, path), data=data, method=method)
    req.add_header("Authorization", f"Bearer {cfg.get('secret','')}")
    if data:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            txt = r.read().decode()
            return json.loads(txt) if txt.strip() else {}
    except urllib.error.HTTPError as e:
        return {"__error__": e.code, "message": e.read().decode(errors="replace")[:200]}
    except Exception as e:
        return {"__error__": str(e)}


