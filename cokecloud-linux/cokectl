        f.write("[Desktop Entry]\nType=Application\n"
                "Name=CokeCloud Provider\n"
                f"Exec={sys.executable} {os.path.abspath(__file__)} serve run\n"
                "X-GNOME-Autostart-enabled=true\nTerminal=false\n")
    return path


def _build_merged(force=False):
    """带缓存的配置构建(5 分钟过期,?refresh=1 强制)。"""
    with _srv_state["lock"]:
        now = time.time()
        if _srv_state["txt"] is None or force or now - _srv_state["ts"] > CACHE_TTL:
            cfg = load_cfg()
            patched, raw = build_config_text(cfg)
            _srv_state["txt"] = patched
            _srv_state["ts"] = now
            try:
                write_private(RUNTIME_YAML, patched)
            except OSError:
                pass
        if (_srv_state["plan"] is None
                or now - _srv_state["plan_ts"] > 600):
            info = fetch_plan_info(load_cfg())
            if info:
                _srv_state["plan"] = info
                _srv_state["plan_ts"] = now
                try:
                    write_private(os.path.join(CONF_DIR, "plan.json"),
                                  json.dumps(info, ensure_ascii=False))
                except OSError:
                    pass
        return _srv_state["txt"], _srv_state["plan"]


class _ServeHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass

    def _reply(self, code, body, ctype="text/plain; charset=utf-8",
               extra=None):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        p = urllib.parse.urlparse(self.path)
        qs = urllib.parse.parse_qs(p.query)
        try:
            if p.path in ("/merged.yaml", "/config", "/sub.yaml",
                          "/cokecloud.yaml"):
                txt, plan = _build_merged(
                    force="1" in (qs.get("refresh") or []))
                extra = {}
                if plan:
                    extra["Subscription-Userinfo"] = (
                        f"upload=0; download={plan['used']}; "
                        f"total={plan['total']}; expire={plan['expire']}")
                self._reply(200, txt, "text/yaml; charset=utf-8", extra)
            elif p.path == "/healthz":
                self._reply(200, "ok")
            elif p.path == "/":
                self._reply(200,
                            "CokeCloud 本地订阅提供器\n"
                            "订阅地址: http://127.0.0.1:%d/merged.yaml\n"
                            % self.server.server_address[1])
            else:
                self._reply(404, "not found")
        except Exception as e:
            self._reply(502, f"build config failed: {e}")


def _serve_run():
    cfg = load_cfg()
    port = int(cfg.get("provider_port", SERVE_PORT_DEFAULT))
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), _ServeHandler)

    def _term(signo, _frame):
        threading.Thread(target=srv.shutdown, daemon=True).start()
    signal.signal(signal.SIGTERM, _term)
    signal.signal(signal.SIGINT, _term)
    try:
        srv.serve_forever()
    finally:
        srv.server_close()


def _serve_is_alive():
    if not os.path.exists(SERVE_PID):
        return None
    try:
        pid = int(open(SERVE_PID).read().strip())
        os.kill(pid, 0)
        return pid
    except (ValueError, ProcessLookupError):
        return None
    except PermissionError:
        return pid


def cmd_serve(args):
    """本地订阅提供器:供 Clash Verge 引用全量节点。serve start|stop|run|status"""
    sub = args[0] if args else "status"
    cfg = load_cfg()
    port = int(cfg.get("provider_port", SERVE_PORT_DEFAULT))
    url = f"http://127.0.0.1:{port}/merged.yaml"
    if sub == "run":
        with open(SERVE_PID, "w") as f:
            f.write(str(os.getpid()))
        ok(f"订阅提供器已启动: {url}")
        _serve_run()
        return
    if sub == "start":
        pid = _serve_is_alive()
        if pid:
            warn(f"提供器已在运行 (pid {pid})")
        else:
            # 先试构建一次,提前暴露 token/网络问题
            _build_merged()
            with open(SERVE_LOG, "ab") as logf:
                proc = subprocess.Popen(
                    [sys.executable, os.path.abspath(__file__), "serve", "run"],
                    stdout=logf, stderr=subprocess.STDOUT,
                    start_new_session=True)
            with open(SERVE_PID, "w") as f:
                f.write(str(proc.pid))
            time.sleep(1.0)
            if _serve_is_alive() is None:
                die("提供器启动失败,查看 " + SERVE_LOG)
        _autostart_entry()
        ok(f"订阅地址(粘到 Clash Verge 订阅页导入): {url}")
        ok("一键导入命令: ./cokectl verge-import")
        return
    if sub == "stop":
        pid = _serve_is_alive()
        if pid:
            try:
                os.kill(pid, signal.SIGTERM)
            except PermissionError:
                die("无权限停止该进程")
            try:
                os.remove(SERVE_PID)
            except OSError:
                pass
            ok("提供器已停止")
        else:
            warn("提供器未在运行")
        return
    if sub == "status":
        pid = _serve_is_alive()
        print(f"提供器: {'运行中 pid=' + str(pid) if pid else '未运行'}")
        print(f"订阅地址: {url}")
        return
    die("用法: ./cokectl serve start|stop|status|run")


