CACHE_TTL = 300

_srv_state = {"txt": None, "ts": 0.0, "plan": None, "plan_ts": 0.0,
              "lock": threading.Lock()}


def _autostart_entry():
    d = os.path.join(os.path.expanduser("~"), ".config", "autostart")
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, "cokecloud-provider.desktop")
