# ---------------------------------------------------------------- main

USAGE = """用法: cokectl <命令> [参数]

  init              首次配置(订阅链接或账号密码)
  login [邮箱]        登录面板(密码不回显、交互输入),获取「客户端专用」节点权限
  update            更新订阅 + 合并客户端专用节点、生成运行配置
  start|stop|restart|status   内核进程管理
  nodes             列出节点(当前策略组)
  premium           优质节点(直连/0.5x)延迟排序
  use <节点|序号|-a>  切换节点(-a 自动选择)
  mode rule|global|direct     规则/全局/直连 模式
  tun on|off        虚拟网卡 TUN 模式(需 root 授权)
  delay [节点]       测延迟
  test              连通性自检(出口 IP)
  proxy on|off      GNOME 系统代理开关
  env               打印终端代理环境变量
  ui                安装/打开 Web 控制面板
  serve start|stop|status     本地订阅提供器(Clash Verge 用)
  verge-import      一键唤起 Clash Verge 导入全量订阅
  logs [-f]         查看内核日志
  core version      查看内核版本
"""

CMDS = {
    "init": cmd_init, "login": cmd_login, "update": cmd_update,
    "start": cmd_start, "stop": cmd_stop, "restart": cmd_restart, "status": cmd_status,
    "nodes": cmd_nodes, "premium": cmd_premium, "use": cmd_use, "delay": cmd_delay,
    "mode": cmd_mode, "tun": cmd_tun,
    "test": cmd_test, "proxy": cmd_proxy, "env": cmd_env,
    "ui": cmd_ui, "logs": cmd_logs, "core": cmd_core,
    "serve": cmd_serve, "verge-import": cmd_verge_import,
}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(USAGE)
        sys.exit(0)
    cmd = sys.argv[1]
    fn = CMDS.get(cmd)
    if not fn:
        print(f"未知命令: {cmd}\n{USAGE}")
        sys.exit(2)
    ensure_conf_dir()
    fn(sys.argv[2:])
