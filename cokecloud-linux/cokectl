def pick_name(names, query):
    q = query.strip()
    if q.isdigit():
        i = int(q)
        if 0 <= i < len(names):
            return names[i]
        die(f"序号超出范围 0-{len(names)-1}")
    # 精确 -> 包含
    for n in names:
        if n == q:
            return n
    hits = [n for n in names if q in n]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        print("匹配到多个节点:")
        for h in hits:
            print("  -", h)
        die("请用更精确的关键词或序号")
    die(f"找不到匹配 «{q}» 的节点")


