# 服务商面板地址属隐私信息,不入库:从本地配置 api_base 或环境变量
# COKECLOUD_API_BASE 读取;未配置时按需报错提示。
DEFAULT_API_BASE = ""


def api_base(cfg=None):
    """面板地址:本地配置 api_base > 环境变量 COKECLOUD_API_BASE。"""
    base = ((cfg or load_cfg()).get("api_base")
            or os.environ.get("COKECLOUD_API_BASE") or DEFAULT_API_BASE)
    if not base:
        die("尚未配置面板地址:请在 ~/.config/cokecloud/config.json 写入\n"
            "      \"api_base\": \"https://你的面板域名\"\n"
            "      或设置环境变量 COKECLOUD_API_BASE")
    return base.rstrip("/")
SUB_UA = "mihomo/1.19.34 (cokectl-linux)"    # 服务端对此 UA 返回完整 clash 配置
GROUP_MAIN = "🔰 节点选择"                    # 主选择策略组(订阅自带)
GROUP_AUTO = "♻️ 自动选择"

PREMIUM_PAT = re.compile(r"AWSxGCP|GCPxAWS|0\.5x|直连")


# ---------------------------------------------------------------- 工具

def die(msg, code=1):
    print(f"\033[31m[错误]\0330 {msg}", file=sys.stderr)
    sys.exit(code)


def ok(msg):
    print(f"\033[32m[ OK ]\0330 {msg}")


def warn(msg):
    print(f"\033[33m[提醒]\0330 {msg}")


def http_get(url, headers=None, timeout=30, insecure=False):
    req = urllib.request.Request(url, headers=headers or {})
    ctx = None
    if insecure:
        import ssl
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
        return r.read()


def http_json(url, headers=None, timeout=30):
    return json.loads(http_get(url, headers, timeout).decode("utf8"))


def load_cfg():
    if not os.path.exists(CONFIG_JSON):
        return {}
    with open(CONFIG_JSON, encoding="utf8") as f:
        return json.load(f)


def ensure_conf_dir():
    """配置目录收紧为 0700,不随 umask 放开。"""
    os.makedirs(CONF_DIR, exist_ok=True)
    try:
        os.chmod(CONF_DIR, 0o700)
    except OSError:
        pass


def write_private(path, text):
    """写敏感文件(令牌/订阅/节点凭据):权限强制 0600,不随 umask 泄露。"""
    with open(path, "w", encoding="utf8") as f:
        f.write(text)
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def save_cfg(cfg):
    ensure_conf_dir()
    write_private(CONFIG_JSON, json.dumps(cfg, ensure_ascii=False, indent=2))


def api_headers(cfg):
    h = {"User-Agent": SUB_UA}
    tok = cfg.get("api_token")
    if tok:
        h["authorization"] = tok
    return h


# ---------------------------------------------------------------- init / login

def cmd_login(args):
    """账号密码登录,获取面板 API token(用于拉取「客户端专用」节点)。"""
    cfg = load_cfg()
    if args and len(args) >= 2:
        email, password = args[0], args[1]
        warn("密码以命令行参数传入,会留在 shell 历史与进程列表中;建议改用无参数的 ./cokectl login 交互输入")
    else:
        email = input("邮箱: ").strip()
        password = getpass.getpass("密码: ")
    print("登录中 ...")
    body = json.dumps({"email": email, "password": password}).encode()
    req = urllib.request.Request(
        api_base(cfg) + "/api/v1/passport/auth/login",
        data=body,
        headers={"Content-Type": "application/json", "User-Agent": SUB_UA},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            data = json.loads(r.read().decode())
    except Exception as e:
        die(f"登录请求失败: {e}")
    if not data.get("data"):
        die(f"登录失败: {data.get('message', data)}")
    d = data["data"]
    cfg["api_token"] = d.get("token") or d.get("auth_data")
    if args and len(args) >= 2:
        cfg["api_email"] = email
    save_cfg(cfg)
    ok("登录成功,api_token 已保存")
    print("   接下来执行 ./cokectl update 即可合并「客户端专用」节点")


NODES_CACHE = os.path.join(CONF_DIR, "nodes-cache.json")


def fetch_server_list(cfg):
    """官方客户端同款接口:全量节点列表(含「客户端专用」伪装入口域名节点)。
    成功后写本机缓存;面板不可用时用缓存兜底,保证 VIP 节点不丢。"""
    tok = cfg.get("api_token")
    if not tok:
        return None
    api = api_base(cfg)
    nodes = None
    try:
        data = http_json(api + "/api/v1/user/server/fetch",
                         {"authorization": tok, "User-Agent": SUB_UA}, timeout=60)
        nodes = data.get("data") or []
    except urllib.error.HTTPError as e:
        warn(f"面板节点接口失败 HTTP {e.code}(token 可能过期,试试 ./cokectl login)")
    except Exception as e:
        warn(f"面板节点接口不可用({e}),尝试本机缓存 ...")
    if nodes:
        try:
            write_private(NODES_CACHE, json.dumps(nodes, ensure_ascii=False))
        except OSError:
            pass
        return nodes
    if os.path.exists(NODES_CACHE):
        try:
            cached = json.load(open(NODES_CACHE, encoding="utf8"))
            if cached:
                warn("已使用本机缓存的节点清单(面板恢复后自动更新)")
                return cached
        except Exception:
            pass
    return None


def merge_client_nodes(txt, cfg):
    """把面板节点列表里订阅没有的节点(客户端专用)合并进 clash 配置。"""
    try:
        import yaml
    except ImportError:
        warn("未安装 PyYAML(pip3 install --user pyyaml),跳过客户端节点合并")
        return txt
    nodes = fetch_server_list(cfg)
    if nodes is None:
        return txt
    base = yaml.safe_load(txt)
    proxies = base.get("proxies") or []
    have = {(p.get("server"), p.get("port")) for p in proxies}
    names = {p["name"] for p in proxies}
    ss_pwd, vl_uuid = None, None
    for p in proxies:
        if p.get("type") == "ss" and ss_pwd is None:
            ss_pwd = p.get("password")
        if p.get("type") == "vless" and vl_uuid is None:
            vl_uuid = p.get("uuid")
    # 客户端专用节点用伪装域名(如 www.qq.com)做入口,公共 DNS 解析不到真实服务器;
    # 真实入口 = 订阅里出现最多的 ss 中转域名(官方客户端内部同样做了映射)
    import collections as _collections
    host_count = _collections.Counter(
        p.get("server") for p in proxies if p.get("type") == "ss")
    relay_host = host_count.most_common(1)[0][0] if host_count else None
    # 真实中转域名后缀:从订阅中出现最多的中转域名自行推导,不写死服务商域名
    relay_suffix = ("." + relay_host.split(".", 1)[1]
                    if relay_host and "." in relay_host else None)
    new_names = []
    orig_names = set(names)  # 合并前的原节点名,用于识别"全量型"策略组
    for n in nodes:
        if not n.get("is_online") or not n.get("show", 1):
            continue
        host, port = n.get("host"), n.get("port")
        name = n.get("name") or f"node-{n.get('id')}"
        if not host or not port:
            continue
        # 伪装域名(www.qq.com 等)替换为真实中转入口域名;
        # 已是真实中转域名(与订阅中转同域)的条目保持原样
        if relay_host and not (relay_suffix and relay_suffix in host):
            host = relay_host
        if (host, port) in have:
            continue
        t = n.get("type")
        if t == "shadowsocks":
            np = {"name": name, "type": "ss", "server": host, "port": port,
                  "cipher": n.get("cipher") or "chacha20-ietf-poly1305",
                  "password": ss_pwd, "udp": True}
        elif t == "vless":
            ts = n.get("tls_settings") or {}
            np = {"name": name, "type": "vless", "server": host, "port": port,
                  "uuid": vl_uuid, "alterId": 0, "cipher": "auto", "udp": True,
                  "flow": n.get("flow") or "xtls-rprx-vision", "tls": True,
                  "client-fingerprint": "chrome"}
            if ts.get("server_name"):
                np["servername"] = ts["server_name"]
            if ts.get("public_key"):
                np["reality-opts"] = {"public-key": ts["public_key"],
                                      "short-id": ts.get("short_id") or ""}
        else:
            continue
        final = name if name not in names else name + "·专"
        i = 2
        while final in names:
            final = f"{name}·专{i}"
            i += 1
        np["name"] = final
        names.add(final)
        have.add((host, port))
        proxies.append(np)
        new_names.append(final)
    if not new_names:
        ok("面板节点与订阅一致,无需合并")
        return txt
    base["proxies"] = proxies
    # 追加到所有"全量型"策略组(包含全部原节点的组:节点选择/自动/故障转移/
    # 各分流组 YouTube/AI/漏网之鱼 等),保证规则模式下每组都能选到 VIP 节点
    for g in base.get("proxy-groups") or []:
        pl = g.get("proxies")
        if not isinstance(pl, list) or not pl:
            continue
        hit = len([x for x in pl if x in orig_names])
        if hit >= 0.95 * len(orig_names):
            g["proxies"] = pl + new_names
    ok(f"已合并 {len(new_names)} 个「客户端专用」节点(台湾/香港E-G/伪装域名入口等)")
    return yaml.dump(base, allow_unicode=True, sort_keys=False, width=10 ** 6)


def cmd_init(args):
    cfg = load_cfg()
    print("== CokeCloud Linux 客户端 初始化 ==")
    print("1) 粘贴订阅链接 (推荐;在网页「我的订阅」页可复制)")
    print("2) 账号密码登录自动获取")
    way = input("选择方式 [1/2]: ").strip()
    if way == "2":
        email = input("邮箱: ").strip()
        password = getpass.getpass("密码: ")
        sub_url = v2board_login_and_get_sub(email, password)
        cfg["api_email"] = email
        cfg["api_token"] = None  # 登录 token 仅一次性使用
    else:
        sub_url = input("订阅链接: ").strip()
        if "token=" not in sub_url:
            warn("订阅链接里通常包含 token=...,请确认粘贴完整")
    # 提取 token,便于以后拼接不同格式
    m = re.search(r"token=([0-9a-f]{16,64})", sub_url)
    if not m:
        die("无法从链接中解析 token,请检查链接是否完整")
    cfg["sub_url"] = sub_url.strip()
    cfg["token"] = m.group(1)
    cfg.setdefault("mixed_port", 7890)
    cfg.setdefault("api_port", 9090)
    cfg["secret"] = secrets.token_hex(8)
    save_cfg(cfg)
    ok(f"配置已保存到 {CONFIG_JSON}")
    ok("接下来执行: ./cokectl update && ./cokectl start")


def v2board_login_and_get_sub(email, password):
    print("登录中 ...")
    body = json.dumps({"email": email, "password": password}).encode()
    req = urllib.request.Request(
        api_base() + "/api/v1/passport/auth/login",
        data=body,
        headers={"Content-Type": "application/json", "User-Agent": SUB_UA},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            data = json.loads(r.read().decode())
    except Exception as e:
        die(f"登录请求失败: {e}")
    if data.get("data") is None:
        die(f"登录失败: {data.get('message', data)}")
    token = data["data"].get("token") or data["data"].get("auth_data")
    print("获取订阅信息 ...")
    sub = json.loads(http_get(
        api_base() + "/api/v1/user/getSubscribe",
        {"authorization": token, "User-Agent": SUB_UA},
    ).decode())
    url = sub.get("data", {}).get("subscribe_url")
    if not url:
        die("未获取到订阅链接(可能未购买订阅)")
    ok("登录成功")
    return url


# ---------------------------------------------------------------- 订阅下载与配置生成

def fetch_subscription(cfg):
    url = cfg.get("sub_url")
    if not url:
        die("尚未配置订阅,请先执行 ./cokectl init")
    raw = http_get(url, {"User-Agent": SUB_UA}, timeout=60)
    txt = raw.decode("utf8", "replace")
    if "proxies:" not in txt:
        # 有些服务器对未知 UA 返回 base64 节点列表;我们带的 UA 应命中 clash 格式
        try:
            decoded = base64.b64decode(txt + "=" * (-len(txt) % 4)).decode("utf8", "replace")
            if "proxies:" in decoded:
                txt = decoded
        except Exception:
            pass
    if "proxies:" not in txt:
        die("订阅内容不是 clash 格式(可能 token 失效或被限流),请稍后重试")
    write_private(SUB_RAW, txt)
    return txt


def patch_config(txt, cfg):
    """对订阅 clash 配置做文本级补丁,保留原格式。"""
    port = int(cfg.get("mixed_port", 7890))
    api_port = int(cfg.get("api_port", 9090))
    secret = cfg.get("secret", "")

    lines = txt.splitlines()
    out, seen = [], set()
    insert_after_ctrl = []
    for ln in lines:
        if re.match(r"^mixed-port\s*:", ln):
            out.append(f"mixed-port: {port}")
            seen.add("mixed-port")
        elif re.match(r"^port\s*:", ln):
            continue  # 去掉独立 http 端口,统一用 mixed
        elif re.match(r"^socks-port\s*:", ln):
            continue
        elif re.match(r"^allow-lan\s*:", ln):
            out.append("allow-lan: false")  # 安全默认;需要局域网共享再手改
            seen.add("allow-lan")
        elif re.match(r"^bind-address\s*:", ln):
            continue
        elif re.match(r"^external-controller\s*:", ln):
            out.append(f"external-controller: 127.0.0.1:{api_port}")
            seen.add("external-controller")
            insert_after_ctrl = [f"secret: \"{secret}\""]
        elif re.match(r"^secret\s*:", ln):
            continue
        elif re.match(r"^log-level\s*:", ln):
            out.append("log-level: info")
            seen.add("log-level")
            if cfg.get("tun"):
                out += [
                    "tun:",
                    "    enable: true",
                    "    stack: mixed",
                    "    auto-route: true",
                    "    auto-detect-interface: true",
                    "    dns-hijack:",
                    "        - any:53",
                ]
        elif re.match(r"^external-ui\s*:", ln):
            continue  # 后面按需插入
        else:
            out.append(ln)
    # 插入 secret / external-ui
    result = []
    for ln in out:
        result.append(ln)
        if insert_after_ctrl and ln.startswith("external-controller:"):
            if os.path.isdir(UI_DIR):
                insert_after_ctrl.append(f"external-ui: {UI_DIR}")
            result.extend(insert_after_ctrl)
            insert_after_ctrl = []
    if insert_after_ctrl:  # 配置里本来没有 external-controller
        result.append(f"external-controller: 127.0.0.1:{api_port}")
        result.extend(insert_after_ctrl)
    # DNS 监听收紧到本机,并避开常见占用(1053/53)
    result = [re.sub(r"listen:\s*'0\.0\.0\.0:\d+'", "listen: '127.0.0.1:6053'", ln)
              for ln in result]
    return "\n".join(result) + "\n"


def fetch_plan_info(cfg):
    """面板套餐信息(用于流量展示/Subscription-Userinfo)。"""
    tok = cfg.get("api_token")
    if not tok:
        return None
    try:
        api = api_base()
        data = json.loads(http_get(
            api + "/api/v1/user/getSubscribe",
            {"authorization": tok, "User-Agent": SUB_UA}, timeout=30).decode())
        d = data.get("data") or {}
        if d.get("transfer_enable"):
            return {
                "used": d.get("d") or 0,
                "total": d.get("transfer_enable"),
                "expire": d.get("expired_at") or 0,
                "ts": int(time.time()),
            }
    except Exception:
        pass
    return None


def build_config_text(cfg):
    """完整管线:订阅 + 客户端专用节点合并 + 打补丁。"""
    txt = fetch_subscription(cfg)
    txt = merge_client_nodes(txt, cfg)
    return patch_config(txt, cfg), txt


def cmd_update(args):
    cfg = load_cfg()
    if not cfg.get("secret"):
        cfg["secret"] = secrets.token_hex(8)
        save_cfg(cfg)
    print("拉取订阅 ...")
    patched, raw = build_config_text(cfg)
    # SUB_RAW 保存未打补丁的合并版(供 UI/日志查看)
    write_private(SUB_RAW, raw)
    write_private(RUNTIME_YAML, patched)
    ok(f"订阅已更新: {SUB_RAW} ({len(raw.splitlines())} 行)")
    ok(f"运行配置已生成: {RUNTIME_YAML}")


# ---------------------------------------------------------------- 进程管理

def core_alive():
    if not os.path.exists(PID_FILE):
        return None
    try:
        pid = int(open(PID_FILE).read().strip())
        os.kill(pid, 0)
        return pid
    except (ValueError, ProcessLookupError):
        return None
    except PermissionError:
        return pid  # root 进程,本用户无权发信号,但进程存在


def cmd_start(args):
    cfg = load_cfg()
    pid = core_alive()
    if pid:
        warn(f"内核已在运行 (pid {pid})")
        return
    if not os.path.exists(RUNTIME_YAML):
        print("还没有运行配置,先更新订阅 ...")
        cmd_update(args)
    if not os.path.exists(CORE_BIN):
        die(f"找不到内核 {CORE_BIN},请先安装 mihomo 内核")
    # 端口占用检查(带 SO_REUSEADDR 与短暂重试,避免刚停止时的 TIME_WAIT 误报)
    def port_free(p):
        for _ in range(10):
            s = socket.socket()
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                s.bind(("127.0.0.1", p))
                return True
            except OSError:
                time.sleep(0.3)
            finally:
                s.close()
        return False
    for p in (int(cfg.get("mixed_port", 7890)), int(cfg.get("api_port", 9090))):
        if not port_free(p):
            die(f"端口 {p} 已被占用(可能有别的代理在跑),或修改 mixed_port/api_port")
    with open(LOG_FILE, "ab") as logf:
        proc = subprocess.Popen(
            [CORE_BIN, "-d", CONF_DIR, "-f", RUNTIME_YAML],
            stdout=logf, stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    with open(PID_FILE, "w") as f:
        f.write(str(proc.pid))
    time.sleep(1.2)
    if proc.poll() is not None:
        die("内核启动失败,查看日志: ./cokectl logs")
    ok(f"内核已启动 (pid {proc.pid}),混合端口 {cfg.get('mixed_port', 7890)}")
    print(f"   日志: {LOG_FILE}")
    print(f"   控制: http://127.0.0.1:{cfg.get('api_port', 9090)}")


def cmd_stop(args):
    pid = core_alive()
    if not pid:
        warn("内核未在运行")
        return
    helper = os.path.join(APP_DIR, "tun-helper.sh")
    try:
        os.kill(pid, signal.SIGTERM)
        for _ in range(30):
            if core_alive() is None:
                break
            time.sleep(0.1)
        else:
            os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    except PermissionError:
        # root 的 TUN 内核,借 pkexec 停止
        print("TUN 内核以 root 运行,请求授权停止 ...")
        subprocess.run(["pkexec", helper, "stop", PID_FILE, str(os.getuid())],
                       check=False)
    try:
        os.remove(PID_FILE)
    except OSError:
        pass
    ok("内核已停止")


