def measure_delays(cfg, names, timeout_ms=3000):
    proxies, _ = list_groups(cfg)
    out = {}
    for n in names:
        q = urllib.parse.quote(n)
        r = rest(cfg, "GET", f"/proxies/{q}/delay?timeout={timeout_ms}"
                 "&url=http%3A%2F%2Fwww.gstatic.com%2Fgenerate_204")
        if r.get("delay"):
            out[n] = r["delay"]
    return out


